{
  "name": "resovino-site",
  "version": "0.1.0",
  "private": true,
  "description": "ResoVino — Blog vin francophone (Next.js 14 SSG)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && cp -a out/. .",
    "build:static": "next build && cp -a out/. .",
    "start": "next start -p 3000",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\""
  },
  "dependencies": {
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "next-mdx-remote": "5.0.0",
    "gray-matter": "4.0.3",
    "reading-time": "1.5.0",
    "rss": "1.2.2",
    "rehype-slug": "6.0.0",
    "rehype-autolink-headings": "7.1.0",
    "remark-gfm": "4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/rss": "^0.0.32",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "onlyBuiltDependencies": ["unrs-resolver"]
  }
}
